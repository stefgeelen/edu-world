#!/bin/sh
# Na elke commit, op de achtergrond (blokkeert de commit nooit):
# - doc-sync: kijkt of de FSD en de TSD bij moeten (scripts/doc-sync.sh).
#   Overslaan: LEAPIO_DOC_SYNC=0.
# - qa-flow: draait de flowtests tegen de lokale Supabase en meldt kapotte of
#   te complexe flows (scripts/qa-flow.sh). Overslaan: LEAPIO_QA_FLOW=0.

git_dir=$(git rev-parse --git-dir)
# Midden in een rebase of merge niet: de run daarna neemt alles mee.
[ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] || [ -f "$git_dir/MERGE_HEAD" ] && exit 0

root=$(git rev-parse --show-toplevel)

if [ "${LEAPIO_QA_FLOW:-1}" != "0" ]; then
  nohup "$root/scripts/qa-flow.sh" >/dev/null 2>&1 &
fi

if [ "${LEAPIO_DOC_SYNC:-1}" != "0" ] && command -v claude >/dev/null 2>&1; then
  nohup "$root/scripts/doc-sync.sh" >/dev/null 2>&1 &
fi
exit 0
